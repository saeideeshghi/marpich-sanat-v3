{
  "name": "marpich-sanat",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "customize": "node scripts/start-customizer.js",
    "build": "vite build",
    "build:pages": "vite build --mode pages && node scripts/check-pages.js",
    "preview": "vite preview",
    "preview:pages": "vite preview --mode pages",
    "check": "node scripts/check-project.js && node scripts/check-components.js && node scripts/check-handoff.js && node scripts/check-customizer.js && node scripts/check-view-tools.js && node scripts/check-token-editor.js && node scripts/check-platform.js && node scripts/check-publish.js && node scripts/check-github.js",
    "check:assets": "node scripts/check-assets.js",
    "check:pages": "node scripts/check-pages.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean:legacy": "node scripts/clean-legacy.js",
    "publish:github": "node scripts/publish-github.js",
    "github:setup": "node scripts/setup-github.js",
    "tokens:refresh": "node scripts/refresh-tokens.js"
  },
  "devDependencies": {
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
